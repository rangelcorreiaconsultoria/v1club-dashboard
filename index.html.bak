<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>V1 Club Dashboard</title>
    <link rel="stylesheet" href="style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
</head>
<body>
    <div class="app">

        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <span class="logo-v1">V1</span>
                <span class="logo-club">Club</span>
            </div>
            <nav class="sidebar-nav">
                <a href="#" class="nav-item active" data-page="sos">
                    <span class="nav-icon">🚨</span>
                    <span class="nav-label">SOS</span>
                </a>
                <a href="#" class="nav-item" data-page="individual">
                    <span class="nav-icon">📊</span>
                    <span class="nav-label">Individual</span>
                </a>
            </nav>
        </aside>

        <!-- Conteúdo Principal -->
        <main class="main-content">

            <!-- Página SOS -->
            <div id="page-sos" class="page active">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">SOS <span class="badge-alert" id="sos-count">0</span></h1>
                        <p class="page-subtitle">Nutricionistas com poucas publicações na semana</p>
                    </div>
                    <div class="header-filters">
                        <select class="filter-select" id="sos-filtro">
                            <option value="todos">Todos</option>
                            <option value="critico">Atenção Máxima (7+ dias)</option>
                            <option value="alerta">Alerta (3-6 dias)</option>
                            <option value="saudavel">Saudável (0-2 dias)</option>
                        </select>
                        <input type="text" class="filter-search" id="sos-busca" placeholder="Buscar nutricionista...">
                    </div>
                </div>
                <div id="sos-loading" class="loading-state">Carregando dados...</div>
                <div id="sos-grupos"></div>
            </div>

            <!-- Página Individual -->
            <div id="page-individual" class="page">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">Análise Individual</h1>
                        <p class="page-subtitle">Acompanhamento detalhado de atividade no Instagram</p>
                    </div>
                </div>

                <div class="individual-filters">
                    <div class="search-wrapper">
                        <input type="text" id="nutricionista" placeholder="Buscar nutricionista..." class="filter-search" autocomplete="off">
                        <div id="nutricionista-list" class="dropdown-list" style="display:none;"></div>
                    </div>
                    <select id="periodo" class="filter-select">
                        <option value="2">Últimas 2 semanas</option>
                        <option value="4">Últimas 4 semanas</option>
                        <option value="8">Últimas 8 semanas</option>
                        <option value="custom">Personalizado</option>
                    </select>
                    <div id="custom-dates" style="display:none; gap:8px; align-items:center;">
                        <input type="date" id="data-inicio" class="filter-select">
                        <input type="date" id="data-fim" class="filter-select">
                        <button id="aplicar-custom" class="btn-primary">Aplicar</button>
                    </div>
                </div>

                <div id="individual-loading" class="loading-state" style="display:none;">Carregando dados...</div>
                <div id="individual-error" class="error-state" style="display:none;"></div>

                <div id="individual-content" style="display:none;">
                    <div class="profile-card">
                        <div class="profile-avatar" id="ind-avatar">?</div>
                        <div class="profile-info">
                            <h2 id="ind-username">—</h2>
                            <p id="ind-ultimo-post" class="profile-meta">—</p>
                        </div>
                        <div class="profile-stats">
                            <div class="profile-stat">
                                <span class="stat-value" id="ind-posts">0</span>
                                <span class="stat-label">Posts</span>
                            </div>
                            <div class="profile-stat">
                                <span class="stat-value" id="ind-reels">0</span>
                                <span class="stat-label">Reels</span>
                            </div>
                            <div class="profile-stat">
                                <span class="stat-value" id="ind-stories">0</span>
                                <span class="stat-label">Stories</span>
                            </div>
                        </div>
                    </div>

                    <div class="charts-grid">
                        <div class="chart-card">
                            <h3 class="chart-title">Atividade por Semana</h3>
                            <canvas id="chart-atividade"></canvas>
                        </div>
                        <div class="chart-card">
                            <h3 class="chart-title">Distribuição de Conteúdo</h3>
                            <canvas id="chart-pizza"></canvas>
                        </div>
                        <div class="engagement-section">
                            <div class="engagement-header">
                                <h2 class="engagement-title">Taxa de Engajamento (%)</h2>
                                <p class="engagement-subtitle">Percentual de stories republicados em relação aos publicados</p>
                            </div>
                            
                            <div class="engagement-chart-container">
                                <canvas id="chart-engajamento"></canvas>
                            </div>
                            
                            <div class="engagement-stats">
                                <div class="stat-card">
                                    <div class="stat-icon">📊</div>
                                    <div class="stat-content">
                                        <p class="stat-label">Média do Período</p>
                                        <p class="stat-value" id="eng-media">0%</p>
                                    </div>
                                </div>
                                
                                <div class="stat-card">
                                    <div class="stat-icon">⬆️</div>
                                    <div class="stat-content">
                                        <p class="stat-label">Melhor Dia</p>
                                        <p class="stat-value" id="eng-melhor">0%</p>
                                        <p class="stat-secondary" id="eng-melhor-data">-</p>
                                    </div>
                                </div>
                                
                                <div class="stat-card">
                                    <div class="stat-icon">⬇️</div>
                                    <div class="stat-content">
                                        <p class="stat-label">Pior Dia</p>
                                        <p class="stat-value" id="eng-pior">0%</p>
                                        <p class="stat-secondary" id="eng-pior-data">-</p>
                                    </div>
                                </div>
                                
                                <div class="stat-card">
                                    <div class="stat-icon">📅</div>
                                    <div class="stat-content">
                                        <p class="stat-label">Total de Dias</p>
                                        <p class="stat-value" id="eng-dias">0</p>
                                        <p class="stat-secondary">com dados</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="chart-card full-width">
                            <h3 class="chart-title">Stories: Publicados vs Republicados</h3>
                            <canvas id="chart-stories"></canvas>
                        </div>
                    </div>
                </div>
            </div>

        </main>
    </div>
    <script src="script.js"></script>
</body>
</html>
